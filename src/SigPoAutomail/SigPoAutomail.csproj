<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OutlookAutomail</AssemblyName>
    <RootNamespace>SigPoAutomail</RootNamespace>
    <Product>Outlook Automail</Product>
    <Description>Scheduled attachment emails through classic Outlook from shared folders.</Description>
    <Version>1.3.0</Version>
    <Version Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../release.json" LogicalName="OutlookAutomail.release.json" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="SigPoAutomail.Tests" />
  </ItemGroup>
</Project>
