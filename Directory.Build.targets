<Project>
  <Target Name="SelectWebView2DesktopControl" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseWindowsForms)' == 'true' And '$(UseWPF)' != 'true'">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
